<%- include('./layouts/main-top') %>

<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a> <i class="fas fa-chevron-right"></i> 
      <a href="/goi-kham">Gói Khám</a> <i class="fas fa-chevron-right"></i> 
      <span><%= pkg.name %></span>
    </nav>
    <h1 class="page-title"><%= pkg.name %></h1>
    <p class="page-desc"><%= pkg.description %></p>
  </div>
</section>

<!-- Package Detail Content -->
<section class="section">
  <div class="container">
    <div class="package-detail-layout">
      <!-- Main Content (Left) -->
      <div class="package-detail-main" data-aos="fade-up">
        <!-- Ảnh bìa đại diện gói khám -->
        <div class="package-detail-hero-img">
          <img src="<%= pkg.image_url || 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=800&h=600&fit=crop' %>" 
               alt="<%= pkg.name %>" loading="lazy">
        </div>

        <div class="package-detail-header">
          <h2 class="package-detail-title"><%= pkg.name %></h2>
          <p class="package-detail-lead"><%= pkg.description %></p>
        </div>

        <!-- Danh mục kiểm tra trong gói -->
        <% 
          var features = [];
          if (pkg.features) {
            try { features = JSON.parse(pkg.features); } catch(e) {}
          }
        %>
        <% if (features.length > 0) { %>
        <h3 class="package-section-title">
          <i class="fas fa-clipboard-check"></i> Danh Mục & Hạng Mục Khám Chi Tiết
        </h3>
        <div class="package-detail-features-grid">
          <% features.forEach(function(item) { %>
          <div class="package-feature-item">
            <i class="fas fa-check-circle"></i>
            <span><%= item %></span>
          </div>
          <% }) %>
        </div>
        <% } %>

        <!-- Đối tượng nên thực hiện -->
        <h3 class="package-section-title">
          <i class="fas fa-user-shield"></i> Đối Tượng Nên Thực Hiện Gói Khám
        </h3>
        <div class="about-simple-text" style="margin-bottom: 24px;">
          <% if (pkg.target_audience && pkg.target_audience.trim()) { %>
            <% 
              const lines = pkg.target_audience.split('\n').map(l => l.trim()).filter(Boolean);
              lines.forEach(function(line) { 
                const cleanLine = line.startsWith('•') || line.startsWith('-') ? line.replace(/^[•\-]\s*/, '') : line;
            %>
              <p>• <%= cleanLine %></p>
            <% }) %>
          <% } else { %>
            <p>• Người muốn kiểm tra sức khỏe tổng quát và tầm soát sớm các bệnh lý tiềm ẩn.</p>
            <p>• Người có tiền sử gia đình mắc các bệnh lý liên quan hoặc người có lối sống bận rộn, căng thẳng.</p>
            <p>• Người xuất hiện các dấu hiệu mệt mỏi, sụt cân không rõ nguyên nhân hoặc cần kiểm tra định kỳ 6 - 12 tháng/lần.</p>
          <% } %>
        </div>

        <!-- Hình ảnh chi tiết đính kèm của gói khám (Đặt ngay dưới Đối tượng) -->
        <% 
          var detailImagesList = [];
          if (pkg.detail_images) {
            try {
              detailImagesList = typeof pkg.detail_images === 'string' ? JSON.parse(pkg.detail_images) : pkg.detail_images;
              if (!Array.isArray(detailImagesList)) detailImagesList = [];
            } catch(e) {
              detailImagesList = [];
            }
          }
        %>
        <% if (detailImagesList && detailImagesList.length > 0) { %>
          <div class="package-detail-gallery" style="margin-bottom: 30px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <% detailImagesList.forEach(function(imgUrl, idx) { %>
                <div style="border-radius: 12px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 4px 16px rgba(0,0,0,0.06);">
                  <img src="<%= imgUrl %>" alt="Hình ảnh chi tiết <%= idx + 1 %>" style="width: 100%; height: auto; display: block;" loading="lazy">
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Quy trình khám 4 bước -->
        <h3 class="package-section-title">
          <i class="fas fa-list-ol"></i> Quy trình Thăm khám
        </h3>
        <div class="package-steps-grid">
          <div class="package-step-item">
            <div class="package-step-num">1</div>
            <h5>Đăng ký & Tiếp Nhận</h5>
            <p>Tiếp nhận đăng ký</p>
          </div>
          <div class="package-step-item">
            <div class="package-step-num">2</div>
            <h5>Khám Lâm Sàng</h5>
            <p>Bác sĩ chuyên khoa khám tổng quát và đo chỉ số sinh hiệu.</p>
          </div>
          <div class="package-step-item">
            <div class="package-step-num">3</div>
            <h5>Cận Lâm Sàng</h5>
            <p>Lấy mẫu xét nghiệm và thực hiện chẩn đoán hình ảnh kỹ thuật số.</p>
          </div>
          <div class="package-step-item">
            <div class="package-step-num">4</div>
            <h5>Tư vấn kết quả & Cấp toa</h5>
            <p>Bác sĩ giải thích chi tiết kết quả, tư vấn phác đồ điều trị và cho toa (nếu cần)</p>
          </div>
        </div>

        <!-- Hướng dẫn chuẩn bị trước khi khám -->
        <div class="package-prep-box">
          <h4><i class="fas fa-info-circle"></i> Lưu Ý Chuẩn Bị Trước Khi Đến Khám</h4>
          <ul>
            <li><strong>Nhịn ăn:</strong> Nhịn ăn từ 6 - 8 tiếng trước khi làm xét nghiệm máu (có thể uống một ít nước lọc).</li>
            <li><strong>Uống nước:</strong> Uống đủ nước và nhịn tiểu trước khi thực hiện siêu âm bụng tổng quát.</li>
            <li><strong>Trang phục:</strong> Mặc quần áo thoải mái, thuận tiện cho việc đo huyết áp và thăm khám.</li>
            <li><strong>Hồ sơ cũ:</strong> Mang theo kết quả khám hoặc toa thuốc đang sử dụng (nếu có).</li>
          </ul>
        </div>
      </div>

      <!-- Sidebar (Right) -->
      <div class="package-detail-sidebar">
        <div class="package-sidebar-box">
          <div class="package-price-box">
            <div class="package-price-label">Chi phí trọn gói</div>
            <div class="package-price-val"><%= parseInt(pkg.price || 0).toLocaleString('vi-VN') %> đ</div>
          </div>

          <a href="#dat-lich-ngay" class="btn-primary" style="width: 100%; margin-bottom: 12px;">
            <span>Đặt khám gói này</span> <i class="fas fa-calendar-check"></i>
          </a>
          <a href="tel:<%= clinicPhone.replace(/\s/g,'') %>" class="btn-outlined" style="width: 100%;">
            <span>Hotline tư vấn</span> <i class="fas fa-phone-alt"></i>
          </a>

          <ul class="package-contact-info-list">
            <li><i class="fas fa-shield-alt"></i> Cam kết không phát sinh phụ phí</li>
            <li><i class="fas fa-clock"></i> Thời gian khám: 2 - 3 giờ</li>
            <li><i class="fas fa-file-medical-alt"></i> Trả kết quả online và hồ sơ giấy</li>
            <li><i class="fas fa-user-md"></i> 100% Bác sĩ chuyên khoa trực tiếp khám</li>
          </ul>
        </div>

        <!-- Other Packages -->
        <% if (otherPackages && otherPackages.length > 0) { %>
        <div class="sidebar-widget">
          <h4 class="widget-title">Các Gói Khám Khác</h4>
          <% otherPackages.forEach(function(item) { %>
          <div class="related-item">
            <a href="/goi-kham/<%= item.id %>" class="related-thumb">
              <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=100&h=70&fit=crop' %>" alt="<%= item.name %>">
            </a>
            <div>
              <h5 class="related-title">
                <a href="/goi-kham/<%= item.id %>"><%= item.name %></a>
              </h5>
              <div style="font-size: 0.85rem; font-weight: 800; color: var(--accent);">
                <%= parseInt(item.price || 0).toLocaleString('vi-VN') %> đ
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ===================== BOTTOM APPOINTMENT BOOKING SECTION ===================== -->
<section class="section section-package-booking bg-light" id="dat-lich-ngay">
  <div class="container">
    <div class="booking-section-card" data-aos="fade-up">
      <div class="section-header text-center" style="margin-bottom: 32px;">
        <h2 class="section-title" style="color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px; font-size: 2.1rem; font-weight: 900;">ĐẶT LỊCH HẸN</h2>
      </div>

      <div class="booking-form-wrapper" style="max-width: 860px; margin: 0 auto;">
        <% if (success && success.length > 0) { %>
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i> <%= success[0] %>
        </div>
        <% } %>
        <% if (error && error.length > 0) { %>
        <div class="alert alert-error">
          <i class="fas fa-exclamation-circle"></i> <%= error[0] %>
        </div>
        <% } %>

        <form action="/dat-lich" method="POST" class="booking-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="patient_name">Họ và tên <span class="required">*</span></label>
              <input type="text" id="patient_name" name="patient_name" required
                     placeholder="Nhập họ và tên">
            </div>

            <div class="form-group">
              <label for="phone">Số điện thoại <span class="required">*</span></label>
              <input type="tel" id="phone" name="phone" required
                     placeholder="Nhập số điện thoại">
            </div>

            <div class="form-group">
              <label for="birthday">Ngày sinh <span class="required">*</span></label>
              <div class="input-icon-wrap">
                <input type="text" id="birthday" name="birthday" required
                       placeholder="dd/MM/yyyy" maxlength="10" autocomplete="off"
                       pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}">
                <i class="far fa-calendar-alt input-icon-right"></i>
              </div>
            </div>

            <div class="form-group">
              <label>Giới tính <span class="required">*</span></label>
              <div class="gender-radio-wrap">
                <label class="gender-radio">
                  <input type="radio" name="gender" value="Nam" checked>
                  <span class="radio-dot"></span>
                  <span class="gender-txt">Nam</span>
                </label>
                <label class="gender-radio">
                  <input type="radio" name="gender" value="Nữ">
                  <span class="radio-dot"></span>
                  <span class="gender-txt">Nữ</span>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email"
                     placeholder="Nhập địa chỉ email">
            </div>

            <div class="form-group">
              <label for="package_id">Gói khám lựa chọn <span class="required">*</span></label>
              <select id="package_id" name="package_id" required>
                <% if (allPackages && allPackages.length > 0) { %>
                  <% allPackages.forEach(function(p) { %>
                  <option value="<%= p.id %>" <%= p.id == pkg.id ? 'selected' : '' %>>
                    <%= p.name %>
                  </option>
                  <% }) %>
                <% } else { %>
                  <option value="<%= pkg.id %>" selected><%= pkg.name %></option>
                <% } %>
              </select>
            </div>

            <div class="form-group form-full">
              <label for="openDatetimeModal">Chọn ngày & giờ khám <span class="required">*</span></label>
              <div class="datetime-picker-trigger" id="openDatetimeModal">
                <i class="far fa-calendar-alt"></i>
                <span id="selectedDateTimeText">Chọn ngày & giờ phù hợp</span>
                <i class="fas fa-chevron-down trigger-arrow"></i>
              </div>
              <input type="hidden" id="appointment_date" name="appointment_date" required>
              <input type="hidden" id="appointment_time" name="appointment_time" required>
            </div>

            <div class="form-group form-full">
              <label for="notes">Ghi chú thêm / Triệu chứng cần lưu ý</label>
              <textarea id="notes" name="notes" rows="3"
                        placeholder="Nhập ghi chú hoặc mô tả triệu chứng (nếu có)..."></textarea>
            </div>

            <div class="form-group form-full privacy-checkbox-wrap">
              <label class="privacy-checkbox-label" for="agree_privacy">
                <input type="checkbox" name="agree_privacy" id="agree_privacy" required>
                <span class="custom-checkbox"></span>
                <span class="privacy-text">
                  Tôi xác nhận đã đọc và đồng ý với <a href="/chinh-sach-bao-mat" target="_blank" class="privacy-link">chính sách bảo mật.</a>
                </span>
              </label>
            </div>
          </div>

          <div class="form-submit text-center" style="margin-top: 28px;">
            <button type="submit" class="btn-primary" style="padding: 14px 60px; font-size: 1.05rem; min-width: 180px;">
              <span>Gửi</span> <i class="fas fa-paper-plane" style="margin-left: 8px;"></i>
            </button>
          </div>
        </form>

        <!-- Booking Notice / Guide (Hoan My Style) -->
        <div class="booking-notice-box" style="margin-top: 36px; padding-top: 26px; border-top: 1px solid var(--border); font-size: 0.92rem; color: #4b5563; line-height: 1.75;">
          <p style="font-weight: 600; color: #1f2937; margin-bottom: 12px;">*Lưu ý: Thời gian khám bệnh trên chỉ là thời gian ước tính, đường dây nóng sẽ liên hệ với bạn để xác nhận thời gian khám bệnh chính xác sau khi bạn đặt lịch hẹn.</p>
          <p style="margin-bottom: 10px;">Nếu bạn muốn đặt lịch khám tại <strong><%= typeof clinicName !== 'undefined' ? clinicName : (locals.clinicName || 'Phòng Khám VIP') %></strong>, vui lòng làm theo hướng dẫn sau:</p>
          <ul style="list-style: disc; padding-left: 22px; margin-bottom: 14px;">
            <li style="margin-bottom: 6px;">Để đặt lịch hẹn, vui lòng gọi đến đường dây nóng của bộ phận chăm sóc khách hàng theo số <a href="tel:<%= clinicPhone.replace(/\s/g,'') %>" style="color: var(--primary); font-weight: 700;"><%= clinicPhone %></a>.</li>
            <li style="margin-bottom: 6px;">Để đặt lịch hẹn trực tuyến, vui lòng điền thông tin vào biểu mẫu trên.</li>
          </ul>
          <p style="color: #6b7280; font-style: italic; margin-bottom: 0;">Xin lưu ý rằng trong các tình huống khẩn cấp, bạn nên đến trực tiếp cơ sở y tế gần nhất.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== DATETIME PICKER MODAL (HOAN MY STYLE) ===================== -->
<div class="datetime-modal" id="datetimeModal">
  <div class="dt-modal-overlay"></div>
  <div class="dt-modal-container">
    <button type="button" class="dt-modal-close" aria-label="Đóng"><i class="fas fa-times"></i></button>
    <div class="dt-modal-header">
      <h3>Chọn ngày & giờ phù hợp</h3>
      <p><%= typeof clinicName !== 'undefined' ? clinicName : (locals.clinicName || 'Phòng Khám VIP') %></p>
    </div>

    <div class="dt-modal-body">
      <div class="dt-modal-section-title">Chọn ngày</div>
      <div class="dates-grid" id="modalDatesGrid">
        <!-- Generated by JavaScript -->
      </div>

      <div class="dt-modal-section-title">Chọn giờ</div>
      <div class="time-slots-grid">
        <button type="button" class="time-slot-btn active" data-time="07:30">07:30</button>
        <button type="button" class="time-slot-btn" data-time="08:00">08:00</button>
        <button type="button" class="time-slot-btn" data-time="08:30">08:30</button>
        <button type="button" class="time-slot-btn" data-time="09:00">09:00</button>
        <button type="button" class="time-slot-btn" data-time="09:30">09:30</button>
        <button type="button" class="time-slot-btn" data-time="10:00">10:00</button>
        <button type="button" class="time-slot-btn" data-time="10:30">10:30</button>
        <button type="button" class="time-slot-btn" data-time="11:00">11:00</button>
        <button type="button" class="time-slot-btn" data-time="13:30">13:30</button>
        <button type="button" class="time-slot-btn" data-time="14:00">14:00</button>
        <button type="button" class="time-slot-btn" data-time="14:30">14:30</button>
        <button type="button" class="time-slot-btn" data-time="15:00">15:00</button>
        <button type="button" class="time-slot-btn" data-time="15:30">15:30</button>
        <button type="button" class="time-slot-btn" data-time="16:00">16:00</button>
      </div>

      <div class="dt-modal-footer">
        <button type="button" class="btn-primary" id="btnConfirmDateTime" style="padding: 12px 36px;">
          Hoàn tất lựa chọn
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('./layouts/main-bottom') %>