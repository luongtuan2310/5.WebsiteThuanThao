<%- include('../layouts/admin-top') %>
<div class="card">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div class="card-title"><i class="fas fa-images" style="color: var(--primary);"></i> Danh sách Banner (<%= banners.length %>)</div>
    <a href="/admin/banners/create" class="btn btn-primary" style="font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
      <i class="fas fa-plus"></i> Thêm mới
    </a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width: 50px;">#</th>
          <th style="width: 140px;">Ảnh</th>
          <th>Tên Banner</th>
          <th style="width: 90px; text-align: center;">Thứ tự</th>
          <th style="width: 170px; text-align: center;">Trạng thái</th>
          <th style="width: 150px; text-align: right;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (banners.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align: center; padding: 30px; color: #94a3b8;">
            Chưa có banner nào. Hãy bấm <strong>+ Thêm mới</strong> để tạo banner.
          </td>
        </tr>
        <% } %>
        <% banners.forEach(function(b) { %>
        <tr id="banner_row_<%= b.id %>">
          <td><%= b.id %></td>
          <td class="td-img">
            <img src="<%= b.image_url %>" alt="<%= b.title %>" style="width: 120px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0;">
          </td>
          <td>
            <strong style="color: #1e293b; font-size: 0.95rem;"><%= b.title %></strong>
            <% if (b.content_title) { %>
              <div style="font-size: 0.8rem; color: #0284c7; margin-top: 2px;">
                <i class="fas fa-heading"></i> <%= b.content_title %>
              </div>
            <% } %>
          </td>
          <td style="text-align: center;"><%= b.sort_order %></td>
          <td style="text-align: center;">
            <button type="button" 
                    class="btn-toggle-status" 
                    data-id="<%= b.id %>" 
                    data-active="<%= b.is_active ? 1 : 0 %>"
                    title="Click để thay đổi trạng thái nhanh"
                    style="cursor: pointer; border: none; padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease; <%= b.is_active ? 'background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;' : 'background: #fef9c3; color: #854d0e; border: 1px solid #fde047;' %>">
              <i class="fas <%= b.is_active ? 'fa-check-circle' : 'fa-clock' %>"></i>
              <span class="status-label"><%= b.is_active ? '🟢 Hiển thị' : '🟡 Lưu Nháp' %></span>
            </button>
          </td>
          <td style="text-align: right;">
            <div style="display: inline-flex; gap: 6px;">
              <button type="button" 
                      class="btn btn-sm btn-quick-toggle" 
                      data-id="<%= b.id %>"
                      title="<%= b.is_active ? 'Tắt hiển thị (Chuyển sang Nháp)' : 'Bật hiển thị (Xuất bản)' %>"
                      style="padding: 6px 10px; border-radius: 6px; <%= b.is_active ? 'background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1;' : 'background: #dcfce7; color: #15803d; border: 1px solid #86efac;' %>">
                <i class="fas <%= b.is_active ? 'fa-eye-slash' : 'fa-eye' %>"></i>
              </button>
              <a href="/admin/banners/<%= b.id %>/edit" class="btn btn-warning btn-sm" title="Chỉnh sửa chi tiết" style="padding: 6px 10px; border-radius: 6px;">
                <i class="fas fa-edit"></i>
              </a>
              <form action="/admin/banners/<%= b.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa banner này?')">
                <button type="submit" class="btn btn-danger btn-sm" title="Xóa banner" style="padding: 6px 10px; border-radius: 6px;">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function handleToggle(bannerId, buttonEl, quickBtnEl) {
    buttonEl.style.opacity = '0.5';
    buttonEl.style.pointerEvents = 'none';

    fetch(`/admin/banners/${bannerId}/toggle`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(res => res.json())
    .then(data => {
      buttonEl.style.opacity = '1';
      buttonEl.style.pointerEvents = 'auto';

      if (data && data.success) {
        const isActive = data.is_active;
        buttonEl.setAttribute('data-active', isActive ? '1' : '0');

        if (isActive) {
          buttonEl.style.background = '#dcfce7';
          buttonEl.style.color = '#15803d';
          buttonEl.style.border = '1px solid #bbf7d0';
          buttonEl.innerHTML = '<i class="fas fa-check-circle"></i> <span class="status-label">🟢 Hiển thị</span>';
          
          if (quickBtnEl) {
            quickBtnEl.style.background = '#f1f5f9';
            quickBtnEl.style.color = '#64748b';
            quickBtnEl.style.border = '1px solid #cbd5e1';
            quickBtnEl.title = 'Tắt hiển thị (Chuyển sang Nháp)';
            quickBtnEl.innerHTML = '<i class="fas fa-eye-slash"></i>';
          }
        } else {
          buttonEl.style.background = '#fef9c3';
          buttonEl.style.color = '#854d0e';
          buttonEl.style.border = '1px solid #fde047';
          buttonEl.innerHTML = '<i class="fas fa-clock"></i> <span class="status-label">🟡 Lưu Nháp</span>';

          if (quickBtnEl) {
            quickBtnEl.style.background = '#dcfce7';
            quickBtnEl.style.color = '#15803d';
            quickBtnEl.style.border = '1px solid #86efac';
            quickBtnEl.title = 'Bật hiển thị (Xuất bản)';
            quickBtnEl.innerHTML = '<i class="fas fa-eye"></i>';
          }
        }
      }
    })
    .catch(err => {
      console.error(err);
      buttonEl.style.opacity = '1';
      buttonEl.style.pointerEvents = 'auto';
      alert('Không thể cập nhật trạng thái. Vui lòng thử lại.');
    });
  }

  // Click on Status Badge Button
  document.querySelectorAll('.btn-toggle-status').forEach(btn => {
    btn.addEventListener('click', function() {
      const bannerId = this.getAttribute('data-id');
      const row = document.getElementById('banner_row_' + bannerId);
      const quickBtn = row ? row.querySelector('.btn-quick-toggle') : null;
      handleToggle(bannerId, this, quickBtn);
    });
  });

  // Click on Quick Action Toggle Button
  document.querySelectorAll('.btn-quick-toggle').forEach(btn => {
    btn.addEventListener('click', function() {
      const bannerId = this.getAttribute('data-id');
      const row = document.getElementById('banner_row_' + bannerId);
      const statusBtn = row ? row.querySelector('.btn-toggle-status') : null;
      if (statusBtn) {
        handleToggle(bannerId, statusBtn, this);
      }
    });
  });
});
</script>
<%- include('../layouts/admin-bottom') %>
