<%- include('./layouts/main-top') %>

<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a> <i class="fas fa-chevron-right"></i>
      <a href="/chuyen-khoa">Chuyên Khoa</a> <i class="fas fa-chevron-right"></i>
      <span><%= specialty.name %></span>
    </nav>
    <h1 class="page-title">Chuyên Khoa <%= specialty.name %></h1>
    <p class="page-desc"><%= specialty.description ? (specialty.description.length > 160 ? specialty.description.substring(0, 160) + '...' : specialty.description) : ('Chuyên khoa ' + specialty.name + ' uy tín, chất lượng cao') %></p>
  </div>
</section>

<!-- ===================== SPECIALTY DETAIL CONTENT ===================== -->
<section class="section section-package-detail">
  <div class="container">
    <div class="package-detail-layout">
      <!-- Main Content (Left Column) -->
      <div class="package-detail-main" data-aos="fade-up">
        
        <!-- Large Featured Image (1 hình ảnh lớn) -->
        <figure class="specialty-detail-hero-figure" style="margin: 0 0 32px; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
          <img src="<%= specialty.image_url || 'https://images.unsplash.com/photo-1584515933487-779824d29309?w=1200&h=650&fit=crop' %>" 
               alt="<%= specialty.name %>" 
               style="width: 100%; height: 440px; object-fit: cover; display: block;"
               loading="lazy">
        </figure>

        <!-- Specialty Overview Header -->
        <div class="package-detail-header">
          <span class="section-badge"><i class="fas <%= specialty.icon || 'fa-stethoscope' %>"></i> Khoa Chuyên Sâu</span>
          <h2 class="package-detail-title" style="margin-top: 10px;">Tổng Quan Về Chuyên Khoa <%= specialty.name %></h2>
        </div>

        <!-- Detailed Description Text (Đoạn text mô tả chuyên khoa) -->
        <div class="specialty-detail-content" style="font-size: 0.98rem; color: #374151; line-height: 1.8;">
          <h3 class="package-section-title"><i class="fas fa-notes-medical"></i> Giới Thiệu & Năng Lực Chuyên Môn</h3>
          <% if (specialty.description && specialty.description.trim()) { %>
            <div class="specialty-description-body" style="white-space: pre-line; margin-bottom: 24px; color: #374151; line-height: 1.8;">
              <%= specialty.description %>
            </div>
          <% } else { %>
            <p>
              Chuyên khoa <strong><%= specialty.name %></strong> tại <strong><%= typeof clinicName !== 'undefined' ? clinicName : (locals.clinicName || 'Phòng Khám VIP') %></strong> được đầu tư đồng bộ về cơ sở vật chất, trang thiết bị y tế hiện đại cùng đội ngũ chuyên gia, bác sĩ giàu kinh nghiệm, tận tâm phục vụ người bệnh.
            </p>
            <p>
              Chúng tôi áp dụng các phác đồ chẩn đoán và điều trị tiên tiến theo tiêu chuẩn quốc tế, giúp phát hiện sớm các bệnh lý, đưa ra lộ trình can thiệp kịp thời, an toàn và tối ưu hóa hiệu quả điều trị cho từng cá nhân.
            </p>
          <% } %>

          <!-- Doctors of this specialty (if any) -->
          <% if (doctors && doctors.length > 0) { %>
          <h3 class="package-section-title"><i class="fas fa-user-md"></i> Đội Ngũ Bác Sĩ Chuyên Khoa</h3>
          <div class="doctors-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <% doctors.forEach(function(doc) { %>
            <div class="doctor-card" style="background: #ffffff; border-radius: 12px; border: 1px solid var(--border); overflow: hidden; padding: 18px; text-align: center; box-shadow: 0 4px 14px rgba(0,0,0,0.05);">
              <img src="<%= doc.image_url || 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&h=400&fit=crop' %>" 
                   alt="<%= doc.name %>" 
                   style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; margin: 0 auto 12px; display: block; border: 3px solid #e0f4f7;">
              <h4 style="font-size: 1.05rem; font-weight: 800; color: #006875; margin-bottom: 4px;"><%= doc.name %></h4>
              <p style="font-size: 0.85rem; color: var(--primary); font-weight: 600; margin-bottom: 8px;"><%= doc.title || 'Bác sĩ chuyên khoa' %></p>
              <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 0;"><%= doc.description ? doc.description.substring(0, 90) + '...' : '' %></p>
            </div>
            <% }) %>
          </div>
          <% } %>

          <div class="package-prep-box" style="margin-top: 24px;">
            <h4><i class="fas fa-calendar-alt"></i> Sẵn Sàng Đặt Khám Chuyên Khoa?</h4>
            <p style="margin-bottom: 12px;">Quý khách vui lòng cuộn xuống form bên dưới hoặc nhấn nút Đặt hẹn để được sắp xếp lịch khám với bác sĩ chuyên khoa trong khung giờ thuận tiện nhất.</p>
            <a href="#dat-lich-ngay" class="btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 8px;">
              <i class="fas fa-calendar-check"></i> <span>Đi đến Form Đặt Hẹn</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Sidebar (Right Column) -->
      <aside class="package-detail-sidebar" data-aos="fade-up" data-aos-delay="100">
        <!-- Quick Action Box -->
        <div class="package-sidebar-card">
          <div class="package-card-header">
            <span class="price-label">Tư Vấn Y Khoa</span>
            <div class="package-price-val" style="font-size: 1.35rem; color: #006875;">
              <%= specialty.name %>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px;">Hỗ trợ tư vấn và đăng ký khám nhanh chóng</p>
          </div>

          <div class="package-card-body">
            <a href="#dat-lich-ngay" class="btn-primary btn-block btn-lg" style="margin-bottom: 12px;">
              <i class="fas fa-calendar-check"></i> Đặt khám ngay
            </a>
            
            <div class="sidebar-hotline-info" style="margin: 12px 0 16px; font-size: 0.92rem; color: #374151; line-height: 1.5; display: flex; align-items: flex-start; gap: 8px;">
              <i class="fas fa-phone-alt" style="color: var(--primary); margin-top: 3px; font-size: 0.95rem; flex-shrink: 0;"></i>
              <div style="word-break: break-word;">
                <strong style="color: #1f2937;">Hotline:</strong>
                <a href="tel:<%= (clinicPhone || '').split(/[,/]/)[0].trim().replace(/\s/g,'') %>" style="color: var(--primary); font-weight: 600; text-decoration: none;">
                  <%= clinicPhone %>
                </a>
              </div>
            </div>

            <div class="package-commitments">
              <h4>Cam kết dịch vụ</h4>
              <ul>
                <li><i class="fas fa-shield-alt"></i> Bác sĩ chuyên khoa giàu kinh nghiệm</li>
                <li><i class="fas fa-clock"></i> Tiết kiệm thời gian, không chờ đợi lâu</li>
                <li><i class="fas fa-laptop-medical"></i> Thiết bị chẩn đoán công nghệ cao</li>
                <li><i class="fas fa-file-medical-alt"></i> Hồ sơ sức khỏe bảo mật tuyệt đối</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Other Specialties -->
        <% if (otherSpecialties && otherSpecialties.length > 0) { %>
        <div class="package-sidebar-card" style="margin-top: 24px;">
          <h4 class="sidebar-title"><i class="fas fa-stethoscope"></i> Chuyên Khoa Khác</h4>
          <div class="related-packages-list">
            <% otherSpecialties.slice(0, 2).forEach(function(osp) { %>
            <a href="/chuyen-khoa/<%= osp.id %>" class="related-pkg-item">
              <img src="<%= osp.image_url || 'https://images.unsplash.com/photo-1584515933487-779824d29309?w=200&h=150&fit=crop' %>" 
                   alt="<%= osp.name %>" loading="lazy">
              <div class="related-pkg-info">
                <h5><%= osp.name %></h5>
                <span class="related-pkg-price" style="font-size: 0.82rem; color: var(--primary);">Xem chi tiết &rarr;</span>
              </div>
            </a>
            <% }) %>
          </div>
          <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border);">
            <a href="/chuyen-khoa" class="btn-outlined btn-block" style="display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.88rem; padding: 9px 14px; font-weight: 700; text-decoration: none;">
              <span>Xem thêm chuyên khoa</span> <i class="fas fa-arrow-right" style="font-size: 0.8rem;"></i>
            </a>
          </div>
        </div>
        <% } %>
      </aside>
    </div>
  </div>
</section>

<!-- ===================== BOTTOM APPOINTMENT BOOKING SECTION ===================== -->
<section class="section section-package-booking bg-light" id="dat-lich-ngay">
  <div class="container">
    <div class="booking-section-card" data-aos="fade-up">
      <div class="section-header text-center" style="margin-bottom: 32px;">
        <h2 class="section-title" style="color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px; font-size: 2.1rem; font-weight: 900;">ĐẶT LỊCH HẸN</h2>
      </div>

      <div class="booking-form-wrapper" style="max-width: 860px; margin: 0 auto;">
        <% if (success && success.length > 0) { %>
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i> <%= success[0] %>
        </div>
        <% } %>
        <% if (error && error.length > 0) { %>
        <div class="alert alert-error">
          <i class="fas fa-exclamation-circle"></i> <%= error[0] %>
        </div>
        <% } %>

        <form action="/dat-lich" method="POST" class="booking-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="patient_name">Họ và tên <span class="required">*</span></label>
              <input type="text" id="patient_name" name="patient_name" required
                     placeholder="Nhập họ và tên">
            </div>

            <div class="form-group">
              <label for="phone">Số điện thoại <span class="required">*</span></label>
              <input type="tel" id="phone" name="phone" required
                     placeholder="Nhập số điện thoại">
            </div>

            <div class="form-group">
              <label for="birthday">Ngày sinh <span class="required">*</span></label>
              <div class="input-icon-wrap">
                <input type="text" id="birthday" name="birthday" required
                       placeholder="dd/MM/yyyy" maxlength="10" autocomplete="off"
                       pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}">
                <i class="far fa-calendar-alt input-icon-right"></i>
              </div>
            </div>

            <div class="form-group">
              <label>Giới tính <span class="required">*</span></label>
              <div class="gender-radio-wrap">
                <label class="gender-radio">
                  <input type="radio" name="gender" value="Nam" checked>
                  <span class="radio-dot"></span>
                  <span class="gender-txt">Nam</span>
                </label>
                <label class="gender-radio">
                  <input type="radio" name="gender" value="Nữ">
                  <span class="radio-dot"></span>
                  <span class="gender-txt">Nữ</span>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email"
                     placeholder="Nhập địa chỉ email">
            </div>

            <div class="form-group">
              <label for="package_id">Gói khám lựa chọn</label>
              <select id="package_id" name="package_id">
                <option value="">— Chọn gói khám (Tùy chọn) —</option>
                <% if (allPackages && allPackages.length > 0) { %>
                  <% allPackages.forEach(function(p) { %>
                  <option value="<%= p.id %>">
                    <%= p.name %>
                  </option>
                  <% }) %>
                <% } %>
              </select>
            </div>

            <div class="form-group form-full">
              <label for="openDatetimeModal">Chọn ngày & giờ khám <span class="required">*</span></label>
              <div class="datetime-picker-trigger" id="openDatetimeModal">
                <i class="far fa-calendar-alt"></i>
                <span id="selectedDateTimeText">Chọn ngày & giờ phù hợp</span>
                <i class="fas fa-chevron-down trigger-arrow"></i>
              </div>
              <input type="hidden" id="appointment_date" name="appointment_date" required>
              <input type="hidden" id="appointment_time" name="appointment_time" required>
            </div>

            <div class="form-group form-full">
              <label for="notes">Ghi chú thêm / Triệu chứng cần lưu ý</label>
              <textarea id="notes" name="notes" rows="3"
                        placeholder="Nhập ghi chú hoặc mô tả triệu chứng (nếu có)...">Đăng ký khám chuyên khoa: <%= specialty.name %></textarea>
            </div>

            <div class="form-group form-full privacy-checkbox-wrap">
              <label class="privacy-checkbox-label" for="agree_privacy">
                <input type="checkbox" name="agree_privacy" id="agree_privacy" required>
                <span class="custom-checkbox"></span>
                <span class="privacy-text">
                  Tôi xác nhận đã đọc và đồng ý với <a href="/chinh-sach-bao-mat" target="_blank" class="privacy-link">chính sách bảo mật.</a>
                </span>
              </label>
            </div>
          </div>

          <div class="form-submit text-center" style="margin-top: 28px;">
            <button type="submit" class="btn-primary" style="padding: 14px 60px; font-size: 1.05rem; min-width: 180px;">
              <span>Gửi</span> <i class="fas fa-paper-plane" style="margin-left: 8px;"></i>
            </button>
          </div>
        </form>

        <!-- Booking Notice / Guide (Hoan My Style) -->
        <div class="booking-notice-box" style="margin-top: 36px; padding-top: 26px; border-top: 1px solid var(--border); font-size: 0.92rem; color: #4b5563; line-height: 1.75;">
          <p style="font-weight: 600; color: #1f2937; margin-bottom: 12px;">*Lưu ý: Thời gian khám bệnh trên chỉ là thời gian ước tính, đường dây nóng sẽ liên hệ với bạn để xác nhận thời gian khám bệnh chính xác sau khi bạn đặt lịch hẹn.</p>
          <p style="margin-bottom: 10px;">Nếu bạn muốn đặt lịch khám tại <strong><%= typeof clinicName !== 'undefined' ? clinicName : (locals.clinicName || 'Phòng Khám VIP') %></strong>, vui lòng làm theo hướng dẫn sau:</p>
          <ul style="list-style: disc; padding-left: 22px; margin-bottom: 14px;">
            <li style="margin-bottom: 6px;">Để đặt lịch hẹn, vui lòng gọi đến đường dây nóng của bộ phận chăm sóc khách hàng theo số <a href="tel:<%= clinicPhone.replace(/\s/g,'') %>" style="color: var(--primary); font-weight: 700;"><%= clinicPhone %></a>.</li>
            <li style="margin-bottom: 6px;">Để đặt lịch hẹn trực tuyến, vui lòng điền thông tin vào biểu mẫu trên.</li>
          </ul>
          <p style="color: #6b7280; font-style: italic; margin-bottom: 0;">Xin lưu ý rằng trong các tình huống khẩn cấp, bạn nên đến trực tiếp cơ sở y tế gần nhất.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== DATETIME PICKER MODAL (HOAN MY STYLE) ===================== -->
<div class="datetime-modal" id="datetimeModal">
  <div class="dt-modal-overlay"></div>
  <div class="dt-modal-container">
    <button type="button" class="dt-modal-close" aria-label="Đóng"><i class="fas fa-times"></i></button>
    <div class="dt-modal-header">
      <h3>Chọn ngày & giờ phù hợp</h3>
      <p><%= typeof clinicName !== 'undefined' ? clinicName : (locals.clinicName || 'Phòng Khám VIP') %></p>
    </div>

    <div class="dt-modal-body">
      <div class="dt-modal-section-title">Chọn ngày</div>
      <div class="dates-grid" id="modalDatesGrid">
        <!-- Generated by JavaScript -->
      </div>

      <div class="dt-modal-section-title">Chọn giờ</div>
      <div class="time-slots-grid">
        <button type="button" class="time-slot-btn active" data-time="07:30">07:30</button>
        <button type="button" class="time-slot-btn" data-time="08:00">08:00</button>
        <button type="button" class="time-slot-btn" data-time="08:30">08:30</button>
        <button type="button" class="time-slot-btn" data-time="09:00">09:00</button>
        <button type="button" class="time-slot-btn" data-time="09:30">09:30</button>
        <button type="button" class="time-slot-btn" data-time="10:00">10:00</button>
        <button type="button" class="time-slot-btn" data-time="10:30">10:30</button>
        <button type="button" class="time-slot-btn" data-time="11:00">11:00</button>
        <button type="button" class="time-slot-btn" data-time="13:30">13:30</button>
        <button type="button" class="time-slot-btn" data-time="14:00">14:00</button>
        <button type="button" class="time-slot-btn" data-time="14:30">14:30</button>
        <button type="button" class="time-slot-btn" data-time="15:00">15:00</button>
        <button type="button" class="time-slot-btn" data-time="15:30">15:30</button>
        <button type="button" class="time-slot-btn" data-time="16:00">16:00</button>
      </div>

      <div class="dt-modal-footer">
        <button type="button" class="btn-primary" id="btnConfirmDateTime" style="padding: 12px 36px;">
          Hoàn tất lựa chọn
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('./layouts/main-bottom') %>